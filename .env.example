# DáPraIr? Environment Variables Template
# Copy this file to .env and fill in the secrets for production / local setup

NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://daprair:change_me_db_password@localhost:5433/daprair_db?schema=public

# Authentication & Cryptography (Generate strong random keys)
# openssl rand -base64 32
JWT_SECRET=change_me_jwt_secret_minimum_32_characters_long!
# openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me_minio_access_key
S3_SECRET_KEY=change_me_minio_secret_key
S3_BUCKET_NAME=daprair-media
S3_FORCE_PATH_STYLE=true

# Google Places API (Optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_LIMIT=30
ENABLE_AUTO_GOOGLE_PLACES_SYNC=false
