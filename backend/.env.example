PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://daprair:daprair_password@localhost:5433/daprair_db?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-daprair-plataforma-social-2026-min-32-chars"

# Encryption (AES-256-GCM - 32 bytes in hex, 64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="daprair-media"
S3_FORCE_PATH_STYLE="true"

# Google Places API (Optional in local dev/mock)
GOOGLE_PLACES_API_KEY=""
# Limite diário de requisições à Google Places API (padrão: 30/dia para garantir <= 900 req/mês, com folga sobre as 1.000 gratuitas)
GOOGLE_PLACES_DAILY_LIMIT=30
# Sincronização automática em segundo plano ao navegar (false = 0 requisições automáticas, apenas busca intencional do usuário)
ENABLE_AUTO_GOOGLE_PLACES_SYNC=false

# Auto-elevate user to ADMIN on registration/login (comma-separated or single email)
ADMIN_EMAILS="admin@daprair.com"
